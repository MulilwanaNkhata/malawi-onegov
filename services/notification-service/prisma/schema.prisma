generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Channel {
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  SENT
  FAILED
}

model NotificationLog {
  id             String             @id @default(uuid())
  recipientUserId String
  channel        Channel
  templateCode   String
  subject        String?
  body           String
  status         NotificationStatus
  providerRef    String?
  createdAt      DateTime           @default(now())

  @@index([recipientUserId])
}

/// One row per browser/device a citizen has enabled push on -- a citizen can have several.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}
