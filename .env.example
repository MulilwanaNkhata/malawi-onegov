# Copy to .env at the repo root to override docker-compose defaults.
# None of these are required to start the stack -- docker-compose.yml falls
# back to insecure development defaults for everything below so `docker
# compose up` works with zero configuration. Change all of them before any
# non-local deployment.

POSTGRES_USER=onegov
POSTGRES_PASSWORD=onegov

JWT_SECRET=dev-insecure-jwt-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Off by default for local dev (password alone is enough to log in) -- the
# TOTP system itself is untouched either way: registration still enrolls a
# secret, and /auth/mfa/verify works on demand. Set to true to require the
# second factor at login again.
MFA_REQUIRED=false

AUDIT_SHARED_SECRET=dev-insecure-audit-secret-change-me
SERVICE_SHARED_SECRET=dev-insecure-service-secret-change-me

# Web Push VAPID keypair -- unlike the secrets above, VAPID_PUBLIC_KEY is
# meant to be visible to the browser (that's how a push subscription is
# opened at all); only VAPID_PRIVATE_KEY is sensitive. Generate a real pair
# with `npx web-push generate-vapid-keys` before any non-local deployment.
VAPID_PUBLIC_KEY=BDvqIrVkrem300GUlnrAixIxPcA42_Z1Ad2Ke1akXoNxvuT5idNXCBzguJpH9byy65NtB60fxAXVChip9qORU4w
VAPID_PRIVATE_KEY=K6lEQ4g7fojneQ4mlsVZbQpmFGhQ53FpfCVm91N0sUk
VAPID_SUBJECT=mailto:onegov-admin@example.com

MINIO_ROOT_USER=onegov
MINIO_ROOT_PASSWORD=onegov-secret
