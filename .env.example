# Copy to .env at the repo root to override docker-compose defaults.
# None of these are required to start the stack -- docker-compose.yml falls
# back to insecure development defaults for everything below so `docker
# compose up` works with zero configuration. Change all of them before any
# non-local deployment.

POSTGRES_USER=onegov
POSTGRES_PASSWORD=onegov

JWT_SECRET=dev-insecure-jwt-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

AUDIT_SHARED_SECRET=dev-insecure-audit-secret-change-me
SERVICE_SHARED_SECRET=dev-insecure-service-secret-change-me

MINIO_ROOT_USER=onegov
MINIO_ROOT_PASSWORD=onegov-secret
